<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.AdvancedMetadata</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.AdvancedMetadata</AssemblyName>
    <AssemblyVersion>0.3.10.0</AssemblyVersion>
    <FileVersion>0.3.10.0</FileVersion>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web/config.html">
      <LogicalName>Jellyfin.Plugin.AdvancedMetadata.Web.config.html</LogicalName>
    </EmbeddedResource>
    <None Include="thumb.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Jellyfin cannot load the native SQLite library; the server already has one. -->
  <Target Name="StripNativeRuntimes" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)runtimes" />
  </Target>

</Project>
